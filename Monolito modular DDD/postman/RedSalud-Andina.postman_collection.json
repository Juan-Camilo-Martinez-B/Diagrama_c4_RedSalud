  "item": [
    {
      "name": "00 · Preparación",
      "description": "Utilidades del escenario.",
      "item": [
        {
          "name": "Nuevo escenario (renueva los ids)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/interconsultas/alertas?centroId={{centroId}}",
            "description": "Borra los ids generados: la próxima solicitud crea ids ULID nuevos para repetir todos los flujos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "[\"interconsultaId\",\"episodioOrigenId\",\"cupoId\",\"reservaId\",\"reservaRivalId\",\"episodioId\",\"adjuntoId\",\"recetaId\",\"episodioOfflineId\",\"idempotencyKey\",\"idempotencyKeyBorde\",\"cupoBordeId\",\"reservaBordeId\",\"recetaBordeId\",\"pacienteInterconsultaId\"].concat([\"cupoInicio\", \"cupoFin\", \"claveAdjunto\", \"respuestaLoteL1\", \"selloLoteL1\"]).forEach((n) => pm.collectionVariables.unset(n));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 · Interconsulta y Agenda (outbox)",
      "description": "Una reserva de cupo viaja por el outbox (CupoReservado) y hace pasar la interconsulta a AGENDADA.",
      "item": [
        {
          "name": "Solicitar interconsulta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/interconsultas",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interconsultaId\": \"{{interconsultaId}}\",\n  \"episodioOrigenId\": \"{{episodioOrigenId}}\",\n  \"pacienteId\": \"{{pacienteInterconsultaId}}\",\n  \"centroId\": \"{{centroId}}\",\n  \"especialidad\": \"Cardiología\",\n  \"motivo\": \"Soplo a estudio\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Alertas pendientes (PENDIENTE_AGENDAR)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/interconsultas/alertas?centroId={{centroId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const mia = pm.response.json().find((i) => i.interconsultaId === pm.collectionVariables.get(\"interconsultaId\"));",
                  "pm.test(\"La interconsulta está SOLICITADA, pendiente de agendar\", () => {",
                  "  pm.expect(mia.estado).to.eql(\"SOLICITADA\");",
                  "  pm.expect(mia.alertas).to.include(\"PENDIENTE_AGENDAR\");",
                  "});"
                ]
              }
            }
          ]
        },
