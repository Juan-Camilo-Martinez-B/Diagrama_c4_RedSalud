            "url": "{{baseUrl}}/agenda/cupos/{{cupoId}}/reservas",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservaId\": \"{{reservaRivalId}}\",\n  \"pacienteId\": \"pac-otro\",\n  \"centroId\": \"centro-b\"\n}",
              "options": {
