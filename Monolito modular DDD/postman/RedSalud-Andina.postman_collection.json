                  "  pm.expect(pm.response.json()[0].motivo).to.eql(\"Revisión de examen\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Indicadores del centro en el mes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/analitica/indicadores/{{centroId}}/{{periodo}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Cuenta las teleconsultas cerradas (episodio y lote offline)\", () => pm.expect(pm.response.json().teleconsultas).to.be.at.least(2));"
                ]
