        {
          "name": "Alertas tras el relevo del outbox (AGENDADA)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/interconsultas/alertas?centroId={{centroId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El outbox se releva al bus cada 2 s: se espera a que los eventos lleguen a los consumidores.",
                  "const ms = Number(pm.environment.get(\"esperaRelevoMs\") || 3000);",
                  "setTimeout(() => {}, ms);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const mia = pm.response.json().find((i) => i.interconsultaId === pm.collectionVariables.get(\"interconsultaId\"));",
                  "pm.test(\"CupoReservado la pasó a AGENDADA, pendiente de atención\", () => {",
                  "  pm.expect(mia.estado).to.eql(\"AGENDADA\");",
                  "  pm.expect(mia.alertas).to.include(\"PENDIENTE_ATENCION\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
