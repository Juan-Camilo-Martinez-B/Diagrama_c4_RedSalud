    {
      "name": "03 · Historial clínico (ACL del legado)",
      "description": "El historial se lee del legado a través de la capa anticorrupción, con frescura visible.",
      "item": [
        {
          "name": "Historial del paciente (médico rural)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{medicoRural}}"
              }
            ],
            "url": "{{baseUrl}}/historial/{{pacienteId}}?centroId={{centroId}}&motivo=Interconsulta",
            "description": "La primera lectura viene del legado (LEGADO_DIRECTO); mientras la copia esté vigente, del read model."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const historial = pm.response.json();",
                  "pm.test(\"Traducido al modelo canónico y con frescura visible\", () => {",
                  "  pm.expect([\"LEGADO_DIRECTO\", \"READ_MODEL\"]).to.include(historial.origen);",
                  "  pm.expect(historial.vigente).to.eql(true);",
                  "  pm.expect(historial.documentos[0].tipo).to.eql(\"Laboratorio\");",
                  "  pm.expect(historial.episodios[0].descripcion).to.eql(\"(sin glosa)\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Historial de nuevo (desde el read model)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{especialista}}"
              }
            ],
            "url": "{{baseUrl}}/historial/{{pacienteId}}?centroId={{centroId}}&motivo=Seguimiento",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Servido desde la copia de lectura\", () => pm.expect(pm.response.json().origen).to.eql(\"READ_MODEL\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Historial con un usuario sin perfil (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioSinPerfil}}"
              }
            ],
            "url": "{{baseUrl}}/historial/{{pacienteId}}?centroId={{centroId}}&motivo=Curiosidad",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
