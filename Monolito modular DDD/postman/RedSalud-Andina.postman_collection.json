    {
      "name": "05 · Sincronización offline (diagrama de secuencia)",
      "description": "POST /sync/episodios con Idempotency-Key por lote: 201 al primer intento, 200 con la MISMA respuesta en los reintentos.",
      "item": [
        {
          "name": "Lote L1 – intento 1 (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/sync/episodios",
            "description": "Teleconsulta completa hecha sin conexión, enviada desordenada: se aplica en orden por agregado y secuencia.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"centroId\": \"{{centroId}}\",\n  \"items\": [\n    {\n      \"cambioId\": \"c3\",\n      \"agregadoId\": \"{{episodioOfflineId}}\",\n      \"secuencia\": 3,\n      \"tipo\": \"CIERRE_TELECONSULTA\",\n      \"episodioId\": \"{{episodioOfflineId}}\"\n    },\n    {\n      \"cambioId\": \"c1\",\n      \"agregadoId\": \"{{episodioOfflineId}}\",\n      \"secuencia\": 1,\n      \"tipo\": \"APERTURA_EPISODIO\",\n      \"episodioId\": \"{{episodioOfflineId}}\",\n      \"pacienteId\": \"{{pacienteId}}\"\n    },\n    {\n      \"cambioId\": \"c2\",\n      \"agregadoId\": \"{{episodioOfflineId}}\",\n      \"secuencia\": 2,\n      \"tipo\": \"REGISTRO_ASISTENCIA\",\n      \"episodioId\": \"{{episodioOfflineId}}\",\n      \"campo\": \"MOTIVO\",\n      \"texto\": \"Dolor abdominal\",\n      \"selloInstante\": \"{{selloLoteL1}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Todos los cambios APLICADO\", () => pm.response.json().items.forEach((i) => pm.expect(i.estado).to.eql(\"APLICADO\")));",
                  "pm.collectionVariables.set(\"respuestaLoteL1\", pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Lote L1 – reintento con la misma clave (200, misma respuesta)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/sync/episodios",
            "description": "Simula el corte de red: el cliente reenvía el MISMO lote con la MISMA clave.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"centroId\": \"{{centroId}}\",\n  \"items\": [\n    {\n      \"cambioId\": \"c3\",\n      \"agregadoId\": \"{{episodioOfflineId}}\",\n      \"secuencia\": 3,\n      \"tipo\": \"CIERRE_TELECONSULTA\",\n      \"episodioId\": \"{{episodioOfflineId}}\"\n    },\n    {\n      \"cambioId\": \"c1\",\n      \"agregadoId\": \"{{episodioOfflineId}}\",\n      \"secuencia\": 1,\n      \"tipo\": \"APERTURA_EPISODIO\",\n      \"episodioId\": \"{{episodioOfflineId}}\",\n      \"pacienteId\": \"{{pacienteId}}\"\n    },\n    {\n      \"cambioId\": \"c2\",\n      \"agregadoId\": \"{{episodioOfflineId}}\",\n      \"secuencia\": 2,\n      \"tipo\": \"REGISTRO_ASISTENCIA\",\n      \"episodioId\": \"{{episodioOfflineId}}\",\n      \"campo\": \"MOTIVO\",\n      \"texto\": \"Dolor abdominal\",\n      \"selloInstante\": \"{{selloLoteL1}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Misma respuesta que el intento 1\", () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get(\"respuestaLoteL1\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Misma clave con otro lote (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/sync/episodios",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"centroId\": \"centro-b\",\n  \"items\": [\n    {\n      \"cambioId\": \"x1\",\n      \"agregadoId\": \"{{episodioOfflineId}}\",\n      \"secuencia\": 9,\n      \"tipo\": \"CIERRE_TELECONSULTA\",\n      \"episodioId\": \"{{episodioOfflineId}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Código IDEMPOTENCY_KEY_REUTILIZADA\", () => pm.expect(pm.response.json().codigo).to.eql(\"IDEMPOTENCY_KEY_REUTILIZADA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cupo y receta firmada desde el borde (rechazados)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKeyBorde}}"
              }
            ],
            "url": "{{baseUrl}}/sync/episodios",
            "description": "Cupos y recetas firmadas no se resuelven en el borde: se rechazan y se reintentan contra el servidor.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"centroId\": \"{{centroId}}\",\n  \"items\": [\n    {\n      \"cambioId\": \"r1\",\n      \"agregadoId\": \"{{cupoBordeId}}\",\n      \"secuencia\": 1,\n      \"tipo\": \"RESERVA_CUPO\",\n      \"cupoId\": \"{{cupoBordeId}}\",\n      \"reservaId\": \"{{reservaBordeId}}\",\n      \"pacienteId\": \"{{pacienteId}}\"\n    },\n    {\n      \"cambioId\": \"f1\",\n      \"agregadoId\": \"{{recetaBordeId}}\",\n      \"secuencia\": 1,\n      \"tipo\": \"FIRMA_RECETA\",\n      \"recetaId\": \"{{recetaBordeId}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Ambos RECHAZADO con REQUIERE_SERVIDOR\", () => pm.response.json().items.forEach((i) => {",
                  "  pm.expect(i.estado).to.eql(\"RECHAZADO\");",
                  "  pm.expect(i.codigo).to.eql(\"REQUIERE_SERVIDOR\");",
                  "}));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 · Auditoría y Analítica",
      "description": "Lo que llegó por el outbox a los consumidores: auditoría de lecturas e indicadores del centro.",
      "item": [
        {
          "name": "Quién vio el historial del paciente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auditoria/accesos?recurso=historial/{{pacienteId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// El outbox se releva al bus cada 2 s: se espera a que los eventos lleguen a los consumidores.",
                  "const ms = Number(pm.environment.get(\"esperaRelevoMs\") || 3000);",
                  "setTimeout(() => {}, ms);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"La lectura del médico rural quedó auditada con su motivo\", () => {",
                  "  const lineas = pm.response.json();",
                  "  pm.expect(lineas.some((l) => l.usuarioId === pm.environment.get(\"medicoRural\") && l.motivo === \"Interconsulta\")).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Quién vio el adjunto",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auditoria/accesos?recurso=episodio/{{episodioId}}/adjunto/{{adjuntoId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
