                  "  pm.expect(subida.encabezados[\"x-amz-server-side-encryption\"]).to.eql([\"aws:kms\"]);",
                  "});",
                  "pm.collectionVariables.set(\"claveAdjunto\", subida.claveAlmacenamiento);"
