  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Prepare variables (ULIDs y fechas)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const B32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';",
                  "function ulid() {",
                  "  let t = Date.now(), time = '';",
                  "  for (let i = 0; i < 10; i++) { time = B32[t % 32] + time; t = Math.floor(t / 32); }",
                  "  let rnd = '';",
                  "  for (let i = 0; i < 16; i++) rnd += B32[Math.floor(Math.random() * 32)];",
                  "  return time + rnd;",
                  "}",
                  "['slotId', 'bookingId', 'otherBookingId', 'referralId', 'episodeId', 'attachmentId', 'syncEpisodeId',",
                  " 'syncSlotId', 'syncBookingId', 'prescriptionId'].forEach((name) => pm.collectionVariables.set(name, ulid()));",
                  "pm.collectionVariables.set('syncKey', 'sync-' + ulid());",
                  "const now = Date.now();",
                  "pm.collectionVariables.set('slotStart', new Date(now + 2 * 24 * 3600 * 1000).toISOString());",
                  "pm.collectionVariables.set('slotEnd', new Date(now + 2 * 24 * 3600 * 1000 + 30 * 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('stampEarly', new Date(now - 60 * 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('stampLate', new Date(now - 30 * 60 * 1000).toISOString());",
                  "pm.collectionVariables.set('period', new Date(now).toISOString().slice(0, 7));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/scheduling/slots?specialistId={{specialist}}",
            "description": "Genera ULIDs nuevos para todo el recorrido. Ejecutar primero."
          }
        }
      ]
