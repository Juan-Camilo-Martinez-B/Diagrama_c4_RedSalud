    {
      "name": "04 Episode - offline sync (Idempotency-Key)",
      "item": [
        {
          "name": "Sync batch (first delivery): 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lote procesado: 201', () => pm.response.to.have.status(201));",
                  "const items = pm.response.json().items;",
                  "const byId = Object.fromEntries(items.map((i) => [i.changeId, i]));",
                  "pm.test('Apertura, nota y cierre aplicados', () => pm.expect([byId.c1.status, byId.c2.status, byId.c5.status]).to.eql(['APPLIED', 'APPLIED', 'APPLIED']));",
                  "pm.test('El valor más antiguo pierde por last-writer-wins pero se aplica (queda auditado)', () => pm.expect(byId.c4.status).to.eql('APPLIED'));",
                  "pm.test('La reserva de cupo se rechaza en el borde', () => pm.expect([byId.c6.status, byId.c6.code]).to.eql(['REJECTED', 'REQUIRES_SERVER']));",
                  "pm.collectionVariables.set('syncResult', JSON.stringify(items));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{syncKey}}"
              }
            ],
            "url": "{{baseUrl}}/episodes/sync",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"centerId\": \"{{centerId}}\",\n  \"items\": [\n    {\n      \"changeId\": \"c1\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 1,\n      \"type\": \"OPEN_EPISODE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"patientId\": \"{{patientId}}\"\n    },\n    {\n      \"changeId\": \"c2\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 2,\n      \"type\": \"RECORD_CARE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"field\": \"REASON\",\n      \"text\": \"Fiebre de 3 días\",\n      \"stampedAt\": \"{{stampEarly}}\"\n    },\n    {\n      \"changeId\": \"c3\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 3,\n      \"type\": \"RECORD_CARE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"field\": \"FINDINGS\",\n      \"text\": \"Temperatura 38,5\",\n      \"stampedAt\": \"{{stampLate}}\"\n    },\n    {\n      \"changeId\": \"c4\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 4,\n      \"type\": \"RECORD_CARE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"field\": \"FINDINGS\",\n      \"text\": \"Temperatura 37,9\",\n      \"stampedAt\": \"{{stampEarly}}\"\n    },\n    {\n      \"changeId\": \"c5\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 5,\n      \"type\": \"CLOSE_TELECONSULTATION\",\n      \"episodeId\": \"{{syncEpisodeId}}\"\n    },\n    {\n      \"changeId\": \"c6\",\n      \"aggregateId\": \"{{syncSlotId}}\",\n      \"sequence\": 1,\n      \"type\": \"BOOK_SLOT\",\n      \"slotId\": \"{{syncSlotId}}\",\n      \"bookingId\": \"{{syncBookingId}}\",\n      \"patientId\": \"{{patientId}}\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Same batch again: 200 with the same R",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Repetición: 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve exactamente la misma respuesta R', () => pm.expect(JSON.stringify(pm.response.json().items)).to.eql(pm.collectionVariables.get('syncResult')));",
                  "pm.test('Marcada como repetición', () => pm.expect(pm.response.json().replayed).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{syncKey}}"
              }
            ],
            "url": "{{baseUrl}}/episodes/sync",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"centerId\": \"{{centerId}}\",\n  \"items\": [\n    {\n      \"changeId\": \"c1\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 1,\n      \"type\": \"OPEN_EPISODE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"patientId\": \"{{patientId}}\"\n    },\n    {\n      \"changeId\": \"c2\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 2,\n      \"type\": \"RECORD_CARE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"field\": \"REASON\",\n      \"text\": \"Fiebre de 3 días\",\n      \"stampedAt\": \"{{stampEarly}}\"\n    },\n    {\n      \"changeId\": \"c3\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 3,\n      \"type\": \"RECORD_CARE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"field\": \"FINDINGS\",\n      \"text\": \"Temperatura 38,5\",\n      \"stampedAt\": \"{{stampLate}}\"\n    },\n    {\n      \"changeId\": \"c4\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 4,\n      \"type\": \"RECORD_CARE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"field\": \"FINDINGS\",\n      \"text\": \"Temperatura 37,9\",\n      \"stampedAt\": \"{{stampEarly}}\"\n    },\n    {\n      \"changeId\": \"c5\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 5,\n      \"type\": \"CLOSE_TELECONSULTATION\",\n      \"episodeId\": \"{{syncEpisodeId}}\"\n    },\n    {\n      \"changeId\": \"c6\",\n      \"aggregateId\": \"{{syncSlotId}}\",\n      \"sequence\": 1,\n      \"type\": \"BOOK_SLOT\",\n      \"slotId\": \"{{syncSlotId}}\",\n      \"bookingId\": \"{{syncBookingId}}\",\n      \"patientId\": \"{{patientId}}\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Same key, different batch: 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
                  "pm.test('Código IDEMPOTENCY_KEY_REUSED', () => pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_KEY_REUSED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{syncKey}}"
              }
            ],
            "url": "{{baseUrl}}/episodes/sync",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"centerId\": \"{{centerId}}\",\n  \"items\": [\n    {\n      \"changeId\": \"c1\",\n      \"aggregateId\": \"{{syncEpisodeId}}\",\n      \"sequence\": 1,\n      \"type\": \"OPEN_EPISODE\",\n      \"episodeId\": \"{{syncEpisodeId}}\",\n      \"patientId\": \"{{patientId}}\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Synced episode: last writer wins",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Gana el valor con el sello más reciente', () => pm.expect(body.care.FINDINGS).to.eql('Temperatura 38,5'));",
